-- stdutils.gbn
-- Standar library

class Engine
  const VERSION: str[8] = "1.7.1"
  const AUTHOR: str[10] = "Katsu Dev"
end


var GBN: Engine = $Engine()


class vec2
	var x: float = NULL
	var y: float = NULL

	func init(x: float, y: float) -> NULL
		$self.x = $x
		$self.y = $y
	end

	func zero() -> NULL
		$self.x = 0.0
		$self.y = 0.0
	end
end


class vec2i
	var x: int = NULL
	var y: int = NULL

	func init(x: int, y: int) -> NULL
		$self.x = $x
		$self.y = $y
	end

	func zero() -> NULL
		$self.x = 0
		$self.y = 0
	end
end


class vec3
	var x: float = NULL
	var y: float = NULL
	var z: float = NULL

	func init(x: float, y: float, z: float) -> NULL
		$self.x = $x
		$self.y = $y
		$self.z = $z
	end	

	func zero() -> NULL
		$self.x = 0.0
		$self.y = 0.0
		$self.z = 0.0
	end
end


class vec3i
	var x: int = NULL
	var y: int = NULL
	var z: int = NULL

	func init(x: int, y: int, z: int) -> NULL
		$self.x = $x
		$self.y = $y
		$self.z = $z
	end

	func zero() -> NULL
		$self.x = 0
		$self.y = 0
		$self.z = 0
	end
end



enum Color = {YELLOW, BLUE, RED, GREEN, VIOLET, PURPLE, MAGENTA, PINK, SKYBLUE, BLACK, WHITE, GRAY, ORANGE, LIME}


class color
	var r: float = NULL
	var g: float = NULL
	var b: float = NULL
	var a: float = NULL

	func init(r: float, g: float, b: float, a: float, ?preset: Color) -> NULL
		if $preset is NULL
			$define($r, $g, $b, $a)
			
		else
			match $preset
				case $Color.BLACK
					$define(0.0, 0.0, 0.0, 1.0)
					
				case $Color.BLUE
					$define(0.0, 0.0, 1.0, 1.0)
					
				case $Color.GREEN
					$define(0.0, 1.0, 0.0, 1.0)
						
				case $Color.GRAY
					$define(0.74509805, 0.74509805, 0.74509805, 1.0)
					
				case $Color.ORANGE
					$define(1.0, 0.64705884, 0.0, 1.0)
					
				case $Color.PINK
					$define(1.0, 0.7529412, 0.79607844, 1.0)

				case $Color.PURPLE
					$define(0.627451, 0.1254902, 0.9411765, 1.0)

				case $Color.RED
					$define(1.0, 0.0, 0.0, 1.0)	

				case $Color.SKYBLUE
					$define(0.5294118, 0.80784315, 0.92156863, 1.0)

				case $Color.WHITE
					$define(1.0, 1.0, 1.0, 1.0)

				case $Color.VIOLET
					$define(0.93333334, 0.50980395, 0.93333334, 1.0)

				case $Color.YELLOW
					$define(1.0, 1.0, 0.0, 1.0)

				case $Color.MAGENTA
					$define(1.0, 0.0, 1.0, 1.0)

				case $Color.LIME
					$define(0.0, 1.0, 0.0, 1.0)
					
			end

		end
	end

	func define(r: float, g: float, b: float, a: float) -> NULL
		$self.r = $max($min($r, 0), 1.0)
		$self.g = $max($min($g, 0), 1.0)
		$self.b = $max($min($b, 0), 1.0)
		
		if $a is NULL
			$self.a = 1.0
		
		else
			$self.a = $max($min($a, 0), 1.0)

		end
	end

end


func contains(collection: array, element: any) -> bool
  	for item in $collection
    	if $item == $element
      		return true
    	end
  	end

	return false
end


func index_of(collection: array, element: any) -> int
  	var position: int = 0
  	for $item in $collection
    	if $item == $element
      		return $position
    	end
    	$position = $position + 1
  	end

  	return -1
end


func reverse(list: array) -> array
	var new_list: array = []

	for i in $range(list.size())
		$new_list.push_back(list[-i])
	end

	$new_list.push_back(list[0])
	$new_list.remove(0)

	return $new_list
end


func str_split(text: str[1024], delimiter: str[64]) -> array
  	return text.split(delimiter)
end


func str_join(separator: str[64], items: array) -> str
	var result: str = ""
  	var first: bool = true
  	for $item in $items
    	if first
      		$result = $item
      		$first = false
    	else
      		$result = $result + $separator + $item
    	end
    end
    
	return $result
end


func to_lower(text: str[1024]) -> str
  	return $text.lower()
end


func to_upper(text: str[1024]) -> str
  	return $text.upper()
end


func starts_with(text: str[1024], prefix: str[256]) -> bool
  	return $text.startswith($prefix)
end


func ends_with(text: str[1024], suffix: str[256]) -> bool
	return $text.endswith($suffix)
end


func has_key(mapping: dict, key: any) -> bool
 	return $key in $mapping
end


func input(prompt: str[1024]) -> str
	if $prompt is NULL
    	return $_input("")
  	end

  	return $_input($prompt)
end


func merge_dict(destination: dict, source: dict) -> dict
	var merged: dict = $destination
	for key in $source
    	$merged[$key] = $source[$key]
    end
	return $merged
end


func pause() -> NULL
  	$input("pause> ")
end


func max(entry: float, maximun: float) -> float
	if $entry > $maximun
		return $maximun
	end
	return entry
end


func min(entry: float, minimun: float) -> float
	if $entry < $minimun
		return $minimun
	end
	return $entry
end


func unique(list: array) -> array
	var new_list: array = []

	for i in $list
    	if not $i in $new_list
        	$new_list.append($i)
        end
    end

    return $new_list
end


func flatten(!lists: array) -> array
	var new_list: array = []

	for i in $lists
		for j in $i
			$new_list.append($j)
		end
	end
	return $new_list
end



func replace(text: str[1024], old: str[256], new: str[256]) -> str
    var new_text: str = ""

    if $old == ""
        return $text
    end

    if $new is NULL
        $new = ""
    end

    var i: int = 0

    while $i < $len(text)
        var matching: bool = true

        for j in $range(len(old))
            if $i + $j >= $len(text)
                $matching = false
                break
            end

            if $text[i + j] != $old[j]
                $matching = false
                break
            end
        end

        if $matching
            $new_text += $new
            $i += $len(old)
        else
            $new_text += $text[i]
            $i += 1
        end
    end

    return $new_text
end


func trim(text: str[1024]) -> str
	var new_text: str = ""
	
	for i in $text
		if $i != " "
			$new_text += $i
		else
			$new_text += ""
		end
	end

	return $new_text
end


func repeat(text: str[1024], n: int) -> str
	var new_text: str = text

	for i in $range($n)
		$new_text += $text
	end

	return new_text
end


func is_ptr(value: any) -> bool
	try
		$value.ref
		return true
	catch
		return false
	end	
end


func is_array(value: any) -> bool
	try
		$value[0]
		return true
	catch
		return false
	end
	
end


func is_dict(value: any) -> bool
	try
		if $value == {}
			return false
		end
		$has_key(value, "nan")
		return true
	catch
		return false
	end
	
end


enum Type = {STRING, INT, FLOAT, BOOL, POINTER, OBJECT}

func type_of(variable: any) -> Type
	if $variable is $str
		return Type.STRING

	elif $variable is $int
		return Type.INT

	elif $variable is $float
		return Type.FLOAT

	elif $variable is $bool
		return Type.BOOL

	else
		try
			$variable.ref
			return Type.POINTER
		catch
			if $variable is NULL or ($variable == [] or $variable == {})
				return Type.null
			else
				return Type.OBJECT
			end
		end
	end
end


func type(variable: any) -> any
	if $variable is $str
		return $str

	elif $variable is $int
		return $int

	elif $variable is $float
		return $float

	elif $variable is $bool
		return $bool

	elif $is_ptr(variable)
		return "<class 'ptr'>"
	
	else
		if $variable is NULL or ($variable == [] or $variable == {})
			return NULL
		end
		
		return "<class 'object'>"
	end
end

