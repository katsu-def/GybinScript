#!/usr/bin/Gybin

-- Pointers

var hp: int = 100
var ref: ptr = $$hp

$print($ref.value)
$ref = 200
$print($ref.value)

var memory: ptr = 0x7fff5fbff80c

func sum(a: int, b: int) -> int
	return a + b
end


func init() -> NULL
	var landba: ptr = $$sum
	$print($landba)

	var result: int = $landba.call(2, 4)
	$print($result)
	$print($memory)
end
	
run
